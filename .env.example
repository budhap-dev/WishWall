# ─────────────────────────────────────────────────────────────────────────────
# WishWall environment variables
# Copy to `.env` (git-ignored) and fill in. Validated at startup by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Neon: Dashboard → your project → Connect. Copy the *pooled* connection string
# (host contains "-pooler") here; the app uses it at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Neon *direct* connection string (same, without "-pooler"). Used only by the
# Prisma CLI for migrations. Leave unset locally if you have just one URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Local Docker alternative (`docker compose up -d`): use this for both URLs.
# DATABASE_URL="postgresql://wishwall:wishwall@localhost:5432/wishwall"

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL, used to build share links and for server-side PDF rendering.
APP_URL="http://localhost:3000"

# ── Auth.js / Google sign-in (Phase 2) ──────────────────────────────────────
# Generate with: pnpm dlx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# ── Image uploads (Phase 3) ─────────────────────────────────────────────────
# Parked: photo/GIF uploads are OFF unless this is "true". When off, upload
# buttons are hidden and the server refuses uploads and image attachments.
UPLOADS_ENABLED="false"
# "local" saves to LOCAL_UPLOAD_DIR (dev only; serverless disks are ephemeral).
# "cloudinary" uses Cloudinary's free tier (recommended for production).
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Cloudinary folder that uploads go into.
CLOUDINARY_FOLDER="wishwall"
# Max upload size in bytes (default 4 MB; must stay under Vercel's 4.5 MB
# request limit). Large photos are shrunk in the browser before upload.
UPLOAD_MAX_BYTES="4194304"

# ── Abuse protection (Phase 3) ──────────────────────────────────────────────
# Max new messages per hour, per client IP and per board.
RATE_LIMIT_PER_IP="10"
RATE_LIMIT_PER_BOARD="200"
# Max image uploads per hour per client IP.
RATE_LIMIT_UPLOADS_PER_IP="30"
# Max PDF downloads per hour per client IP (each one runs a headless browser).
RATE_LIMIT_PDF_PER_IP="20"
# Cloudflare Turnstile (free) for guest posts. Set CAPTCHA_ENABLED="true" and
# both keys to turn it on. Cloudflare dashboard → Turnstile → Add site.
CAPTCHA_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Local development ───────────────────────────────────────────────────────
# "true" adds a "Continue as demo user" button to /signin that skips Google.
# Only works under `pnpm dev`; ignored by production builds.
DEV_LOGIN="false"

# ── Tooling ─────────────────────────────────────────────────────────────────
# Set to "1" only for lint/typecheck in CI without real secrets. Never in a deployment.
# SKIP_ENV_VALIDATION="1"
